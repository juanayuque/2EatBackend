// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enums ─────────────────────────
enum Gender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

enum SwipeAction {
  LIKE
  PASS
  SUPERSTAR
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
}

enum GroupRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
}

// ───────────────────────── Friends ─────────────────────────
model FriendRequest {
  id         String              @id @default(uuid())
  fromUserId String
  toUserId   String
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  fromUser User @relation("FriendRequestsSent", fields: [fromUserId], references: [id])
  toUser   User @relation("FriendRequestsReceived", fields: [toUserId], references: [id])

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
}

model Friend {
  id        String   @id @default(uuid())
  userId    String
  friendId  String
  createdAt DateTime @default(now())

  user   User @relation("FriendsOwner", fields: [userId], references: [id])
  friend User @relation("FriendsFriend", fields: [friendId], references: [id])

  @@unique([userId, friendId])
  @@index([friendId])
}

// ───────────────────────── Solo swiping ─────────────────────────
model SwipeSession {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  status      String       @default("active") // active|completed
  startedAt   DateTime     @default(now())
  endedAt     DateTime?
  totalSwipes Int          @default(0)
  context     Json?
  events      SwipeEvent[]
  match       Match?

  @@index([userId, status])
  @@map("swipe_sessions")
}

model SwipeEvent {
  id           String       @id @default(cuid())
  sessionId    String
  session      SwipeSession @relation(fields: [sessionId], references: [id])
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  restaurantId String
  action       SwipeAction
  position     Int
  createdAt    DateTime     @default(now())

  @@index([userId])
  @@index([restaurantId])
  @@map("swipe_events")
}

model Superstar {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  restaurantId String
  sessionId    String?
  createdAt    DateTime @default(now())

  @@unique([userId, restaurantId])
  @@index([sessionId])
  @@map("superstars")
}

model Match {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  sessionId String       @unique
  session   SwipeSession @relation(fields: [sessionId], references: [id])

  top1RestaurantId      String
  top2RestaurantId      String?
  top3RestaurantId      String?
  superStarRestaurantId String?
  winnerRestaurantId    String
  createdAt             DateTime @default(now())

  userComment String?

  @@index([userId])
  @@map("matches")
}

// ───────────────────────── Users ─────────────────────────
model User {
  id          String  @id @default(cuid())
  firebaseUid String  @unique
  email       String? @unique
  username    String? @unique
  displayName String?
  photoUrl    String?

  age               Int?
  gender            Gender?
  searchDistance    Int?     @map("search_distance")
  budgetMax         Int?     @map("budget_max")
  dietaryNeeds      String[] @map("dietary_needs")
  preferredCuisines String[] @map("preferred_cuisines")

  lastLat       Decimal?  @db.Decimal(10, 7)
  lastLng       Decimal?  @db.Decimal(10, 7)
  lastGeoAt     DateTime?
  lastGeoSource String?   // 'device' | 'ip' | 'manual' etc.

  // Solo relations
  sessions   SwipeSession[]
  events     SwipeEvent[]
  superstars Superstar[]
  matches    Match[]

  // Friends relations
  friendRequestsSent     FriendRequest[] @relation("FriendRequestsSent")
  friendRequestsReceived FriendRequest[] @relation("FriendRequestsReceived")
  friendsOwner           Friend[]        @relation("FriendsOwner")
  friendsFriend          Friend[]        @relation("FriendsFriend")

  // Group request relations
  groupRequestsSent     GroupRequest[] @relation("GroupRequestsSent")
  groupRequestsReceived GroupRequest[] @relation("GroupRequestsReceived")

  // Group session relations (all optional to allow backfilling old rows)
  groupSessionsStarted GroupSwipeSession[] @relation("GroupSessionsStarter")
  groupSessionsA       GroupSwipeSession[] @relation("GroupSessionsA")
  groupSessionsB       GroupSwipeSession[] @relation("GroupSessionsB")

  // Group swipe events
  groupEvents GroupSwipeEvent[]

  emailVerified Boolean? @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// ───────────────────────── Restaurants ─────────────────────────
model Restaurant {
  id                       String   @id @default(uuid())
  googlePlaceId            String   @unique @map("google_place_id")
  name                     String
  latitude                 Decimal  @db.Decimal(10, 7)
  longitude                Decimal  @db.Decimal(10, 7)
  formattedAddress         String?  @map("formatted_address") @db.Text
  internationalPhoneNumber String?  @map("international_phone_number")
  websiteUri               String?  @map("website_uri") @db.Text
  primaryTypeDisplayName   String?  @map("primary_type_display_name")
  primaryType              String?  @map("primary_type")
  types                    String[] @map("types")
  rating                   Decimal? @db.Decimal(2, 1)
  userRatingCount          Int?     @map("user_rating_count")
  priceLevel               Int?     @map("price_level")
  servesVegetarianFood     Boolean? @default(false) @map("serves_vegetarian_food")
  editorialSummary         String?  @map("editorial_summary") @db.Text
  plusCode                 String?  @map("plus_code")
  takeout                  Boolean? @default(false)
  dineIn                   Boolean? @default(false) @map("dine_in")
  curbsidePickup           Boolean? @default(false) @map("curbside_pickup")
  delivery                 Boolean? @default(false)
  outdoorSeating           Boolean? @default(false) @map("outdoor_seating")
  allowsDogs               Boolean? @default(false) @map("allows_dogs")
  parkingOptions           Json?    @map("parking_options")
  regularOpeningHours      Json?    @map("regular_opening_hours")

  reviews Review[]
  photos  Photo[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("restaurants")
}

model Review {
  id           String     @id @default(uuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String     @map("restaurant_id")
  author       String
  text         String?    @db.Text
  rating       Decimal    @db.Decimal(2, 1)
  publishTime  DateTime?  @map("publish_time")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("reviews")
}

model Photo {
  id           String     @id @default(uuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String     @map("restaurant_id")
  name         String
  widthPx      Int?       @map("width_px")
  heightPx     Int?       @map("height_px")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("photos")
}

// ───────────────────────── Group swiping ─────────────────────────
model GroupSwipeSession {
  id           String   @id @default(cuid())
  status       String   @default("active")
  startedAt    DateTime @default(now())
  endedAt      DateTime?
  context      Json?

  startedById  String?
  aUserId      String?
  bUserId      String?

  // NEW: per-user swipe counters
  aSwipes      Int      @default(0) @map("a_swipes")
  bSwipes      Int      @default(0) @map("b_swipes")

  startedBy    User?    @relation("GroupSessionsStarter", fields: [startedById], references: [id])
  aUser        User?    @relation("GroupSessionsA",       fields: [aUserId],     references: [id])
  bUser        User?    @relation("GroupSessionsB",       fields: [bUserId],     references: [id])

  events       GroupSwipeEvent[]
  match        GroupMatch?

  @@index([aUserId])
  @@index([bUserId])
  @@index([status])
  @@index([startedById])
  @@map("group_swipe_sessions")
}

model GroupSwipeEvent {
  id           String      @id @default(cuid())
  sessionId    String
  userId       String
  restaurantId String
  action       SwipeAction
  position     Int
  createdAt    DateTime    @default(now())

  session GroupSwipeSession @relation(fields: [sessionId], references: [id])
  user    User              @relation(fields: [userId], references: [id])

  @@index([sessionId])
  @@index([userId])
  @@index([restaurantId])
  @@map("group_swipe_events")
}

model GroupMatch {
  id        String            @id @default(cuid())
  sessionId String            @unique
  session   GroupSwipeSession @relation(fields: [sessionId], references: [id])

  hostUserId   String
  friendUserId String

  top1RestaurantId      String
  top2RestaurantId      String?
  top3RestaurantId      String?
  superStarRestaurantId String?
  winnerRestaurantId    String

  createdAt DateTime @default(now())
  comment   String?

  @@index([hostUserId])
  @@index([friendUserId])
  @@map("group_matches")
}

model GroupRequest {
  id         String             @id @default(uuid())
  fromUserId String
  toUserId   String
  status     GroupRequestStatus @default(PENDING)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  fromUser User @relation("GroupRequestsSent", fields: [fromUserId], references: [id])
  toUser   User @relation("GroupRequestsReceived", fields: [toUserId], references: [id])

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
  @@index([fromUserId, status])
  @@map("group_requests")
}
